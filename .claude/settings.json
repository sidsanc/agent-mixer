{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["linear"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|skill",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR || '.', '.claude', 'hooks', 'check-gstack.cjs'))\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
